rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


    // Users Collection
    match /users/{userId} {
      allow read, write, delete: if true;
    }

    // Suppliers Collection
    match /suppliers/{supplierId} {
      allow read, write, delete: if true;
    }

    // Deleted Accounts Collection
    match /deleted_accounts/{deletedId} {
      allow read, write, delete: if true;
    }

    // Products Collection
    match /products/{productId} {
      allow read, write, delete: if true;
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read, write, delete: if true;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read, write, delete: if true;
    }

    // Deliveries Collection
    match /deliveries/{deliveryId} {
      allow read, write, delete: if true;
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read, write, delete: if true;
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read, write, delete: if true;
    }

    // Supplier Subscriptions Collection
    match /supplier_subscriptions/{subscriptionId} {
      allow read, write, delete: if true;
    }

    // Subscription Plans Collection
    match /subscription_plans/{planId} {
      allow read, write, delete: if true;
    }

    // Order Status History Collection
    match /order_status_history/{historyId} {
      allow read, write, delete: if true;
    }

    // Payment Verification History Collection
    match /payment_verification_history/{verificationId} {
      allow read, write, delete: if true;
    }

    // Inventory Collection
    match /inventory/{inventoryId} {
      allow read, write, delete: if true;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, write, delete: if true;
    }
  }
}
